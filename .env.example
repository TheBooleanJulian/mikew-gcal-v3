# Telegram Bot Configuration
# ============================================

# Bot token from BotFather (@BotFather on Telegram)
# Follow: https://core.telegram.org/bots#botfather
BOT_TOKEN=your_bot_token_here

# Telegram chat/group ID where the bot posts schedules
# You can find this by:
#   1. Add the bot to your group
#   2. Send a message: /start
#   3. Check logs or use a bot like @userinfobot to get the group ID
CHAT_ID=your_chat_id_here

# Comma-separated list of admin user IDs (Telegram user IDs)
# Only these users can execute admin commands (/addshow, /removeshow, etc.)
# To find your user ID, message @userinfobot on Telegram
# Example: ADMIN_IDS=175613011,123456789
ADMIN_IDS=user_id1,user_id2